# ============================================
# BANCO DE DADOS (OBRIGATÓRIO)
# ============================================
DATABASE_URL="postgresql://user:pass@localhost:5432/seu-banco-de-dados?schema=public"

# ============================================
# AUTENTICAÇÃO (OBRIGATÓRIO)
# ============================================
# Use: openssl rand -hex 32
JWT_SECRET="sua_chave_secreta_super_forte_com_32_caracteres_ou_mais"

# [NOVO] Segredo para Tokens Anti-CSRF (Proteção de Formulários)
# Use: openssl rand -hex 32
CSRF_SECRET="outra_chave_secreta_unica_para_csrf"

# ============================================
# EMAIL (OBRIGATÓRIO PARA PRODUÇÃO)
# ============================================
EMAIL_USER="seuemailadmin@provedor.com"
EMAIL_PASS="senha_app_de_email_gerada"

# ============================================
# SUPABASE CONFIG (OBRIGATORIO)
# ============================================
NEXT_PUBLIC_SUPABASE_URL="https://sua-instancia.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua_anon_key"
SUPABASE_SERVICE_ROLE_KEY="sua_service_role_key"

# ============================================
# RATE LIMITING (OBRIGATORIO - UPSTASH)
# ============================================
UPSTASH_REDIS_REST_URL="https://sua-instancia.upstash.io"
UPSTASH_REDIS_REST_TOKEN="seu_token"

# ============================================
# MANUTENÇÃO E CRON JOBS (NOVO - OBRIGATÓRIO)
# ============================================
# Segredo para proteger a rota /api/cron/cleanup-blacklist
# Deve ser igual à configuração de Cron na Vercel
CRON_SECRET="chave_secreta_para_o_cron_job"

# ============================================
# SEED INICIAL (RECOMENDADO)
# ============================================
ADMIN_EMAIL="seuemailadmin@provedor.com"
# [CORREÇÃO AUDITORIA #1] Senha inicial do Admin (Não deixe hardcoded no código)
ADMIN_INITIAL_PASSWORD="Sua_Senha_Super_Segura_123!"

# ============================================
# AMBIENTE
# ============================================
NODE_ENV="development"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"